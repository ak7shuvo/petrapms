# ------------------------------------------------------------------
# PROPETRA — Environment Variables (Example)
# Copy this file to .env and fill in real local values.
# Never commit a real .env file. See docs/SECURITY-ARCHITECTURE.md.
# ------------------------------------------------------------------

# --- Shared ---
NODE_ENV=development

# --- Database (apps/api) ---
# Used by Prisma. Matches the postgres service in docker-compose.yml.
DATABASE_URL="postgresql://propetra:propetra@localhost:5432/propetra?schema=public"
POSTGRES_USER=propetra
POSTGRES_PASSWORD=propetra
POSTGRES_DB=propetra

# --- API (apps/api) ---
API_PORT=3001
WEB_ORIGIN=http://localhost:3000

# --- Auth (apps/api) — Phase 2 ---
# Generate real, distinct, random values for these locally, e.g.:
#   openssl rand -hex 32
# Never reuse the access and refresh secrets. Never commit real values.
JWT_ACCESS_SECRET=replace-with-a-random-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Platform Admin bootstrap (apps/api) — Phase 9 ---
# Set once to create the first TEAM PETRA platform-admin account on
# startup (idempotent). Never commit real values — this is as sensitive
# as any other credential. Leave unset to skip bootstrap entirely.
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=

# --- Rate limiting (apps/api) — Phase 10 ---
# Global default applied to every endpoint (auth.controller.ts overrides
# tighter limits on login/register/refresh specifically — see
# docs/SECURITY-ARCHITECTURE.md — Rate Limiting).
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120

# --- Web (apps/web) ---
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3001
